# CARTO Basemaps API key
PUBLIC_CARTO_KEY=isi_dengan_key_anda_di_sini

# Supabase Credentials (Server & Client)
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_anon_key
SUPABASE_SECRET_KEY=your_service_role_secret_key

# Astro Client-Side Prefixed Variables (Akses Browser / React)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_publishable_anon_key
